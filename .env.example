# Copy this file to .env (a git-ignored file) and fill in real values there.
# Never put a real value in this .env.example file, and never commit .env.

# The Claude API key. This is separate from any Claude Pro subscription or
# Claude Code login — it's created later (Day 2, Lab 4) in the Anthropic
# Console and is billed per token, not by a flat subscription price.
ANTHROPIC_API_KEY=

# Which Claude model v2's live calls will use.
AGENTGUARD_MODEL=claude-sonnet-5

# "mock" = free, deterministic, no network call (the default and safest).
# "live" = real, billed Claude API calls. Only switch this once a later
# lab explicitly walks through it.
AGENTGUARD_MODE=mock

# Caps so a live call can't run away with cost or time.
AGENTGUARD_MAX_OUTPUT_TOKENS=1200
AGENTGUARD_MAX_CALLS_PER_RUN=3

# Rough cost estimates (US dollars per million tokens) used only to show
# an estimated cost in the UI — not billing-accurate, just a sanity check.
AGENTGUARD_ESTIMATED_INPUT_COST_PER_MTOK=3.00
AGENTGUARD_ESTIMATED_OUTPUT_COST_PER_MTOK=15.00
